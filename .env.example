# ── Server ─────────────────────────────────────────────────
PORT=8080
ENVIRONMENT=production
LOG_LEVEL=info

# ── Razorpay (REQUIRED — no mock mode) ───────────────────
# Use real Razorpay TEST MODE keys (rzp_test_...) for staging/dev,
# or LIVE keys (rzp_live_...) for production. The app refuses to
# start without these.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional. Required only if you expose /v1/webhooks/razorpay.
RAZORPAY_WEBHOOK_SECRET=

# ── Policy Controls (Gate 1) ─────────────────────────────
MAX_TRANSACTION_LIMIT_INR=10000
ROLLING_LIMIT_INR=25000
ROLLING_WINDOW_HOURS=24
SKU_WHITELIST=SKU-CLOUD-COMPUTE-01,SKU-STATIONERY-001,SKU-CLOUD-CREDITS-002,SKU-SAAS-LICENSE-03
VENDOR_WHITELIST=vnd_razorpay_whitelisted,vendor_amazon_biz,vendor_aws,vnd_saas_partner

# ── Infrastructure & Network Health (Gate 2) ─────────────────
# Real health is measured from actual Razorpay API calls (a background
# prober + real transaction outcomes) — nothing here is simulated.
UPI_HEALTH_THRESHOLD=0.95
MAX_ACCEPTABLE_LATENCY_MS=4000
MAX_RETRY_ATTEMPTS=5
BACKOFF_BASE_MS=3000
HEALTH_PROBE_INTERVAL_MS=10000
HEALTH_WINDOW_SECONDS=300

# ── Redis (REQUIRED — durable queue, agent registry, decision log) ──
REDIS_URL=redis://localhost:6379

# ── Production Auth ───────────────────────────────
# AGENT_JWT_SECRET: long random string, e.g. `openssl rand -hex 32`
# ADMIN_API_KEY: long random string used to register/revoke agents.
# The app refuses to start without both set.
AGENT_JWT_SECRET=
ADMIN_API_KEY=
JWT_ISSUER=sentinel-ap-gateway
JWT_AUDIENCE=sentinel-ap-transactions
AGENT_JWT_TTL_SECONDS=900
